{
  "expo": {
    "name": "Sunset Staff",
    "slug": "sunset-staff",
    "scheme": "sunsetstaff",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F262B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F262B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunsetbeach.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of a problem when reporting a maintenance task."
      }
    },
    "android": {
      "package": "com.sunsetbeach.staff",
      "adaptiveIcon": {
        "backgroundColor": "#0F262B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of a problem when reporting a maintenance task.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
