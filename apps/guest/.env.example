# Base URL of the sunset API, including its /api context path. Baked into the bundle at build time.
# Point it at a local or staging backend while developing - never production until a release
# build is deliberately made for it. The app refuses to start without it.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api
# Origin of the public site: table QR codes are accepted only from here, and bundled room photos load from it.
EXPO_PUBLIC_SITE_ORIGIN=http://192.168.1.10:3000
